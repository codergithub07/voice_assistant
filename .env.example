# Jarvis Environment Configuration Template
# Copy this file to .env and fill in your values

# External API Keys
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_DEFAULT_CITY=London

# Local File & Media Paths
MEDIA_DIR=/media/tony/ddrive/Movies

# Audio Settings
SAMPLE_RATE=16000
BLOCK_SIZE=8000
AUDIO_CHANNELS=1

# NLP / Classification Thresholds
INTENT_CONFIDENCE_THRESHOLD=0.55
