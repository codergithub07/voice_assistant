# ==========================================
# Jarvis Voice Assistant - Environment Configuration
# ==========================================

# ASR / Speech Recognition Settings
VOSK_MODEL_PATH=vosk_models/vosk-model-small-en-us-0.15
AUDIO_SAMPLE_RATE=16000
AUDIO_BLOCK_SIZE=8000
AUDIO_CHANNELS=1

# NLP / Intent Classification Settings
INTENT_MODEL_DIR=trained_models
INTENT_CONFIDENCE_THRESHOLD=0.55

# Speech Synthesis (TTS) Settings
TTS_ENGINE=pyttsx3
TTS_VOICE_RATE=165

# Media & VLC Settings
MEDIA_DIRECTORY=/media/tony/ddrive/Movies
VLC_PATH=/usr/bin/vlc

# External APIs
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
DEFAULT_LATITUDE=44.34
DEFAULT_LONGITUDE=10.99
